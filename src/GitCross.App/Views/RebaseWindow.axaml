<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitCross.App.ViewModels"
        xmlns:c="using:GitCross.App.Controls"
        xmlns:rb="using:GitCross.Core.Rebase"
        x:Name="RebaseRoot"
        x:Class="GitCross.App.Views.RebaseWindow"
        x:DataType="vm:RebaseViewModel"
        Title="Interactive rebase" Width="780" Height="620" MinWidth="620" MinHeight="460"
        WindowStartupLocation="CenterOwner">
  <DockPanel Margin="20">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="Interactive rebase" FontSize="22" FontWeight="Bold" />
      <TextBlock Text="{Binding OntoLabel, StringFormat='Replaying the commits after {0}, applied from top to bottom.'}" Classes="muted" TextWrapping="Wrap" />
      <TextBlock Text="Reorder with ▲▼, choose what happens to each commit. Rewriting commits you already pushed will require a force push." Classes="muted" FontSize="12" TextWrapping="Wrap" />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,12,0,0">
      <TextBlock Text="{Binding Problem}" IsVisible="{Binding HasProblem}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Click="OnCancel" />
        <Button x:Name="StartButton" Classes="accent" Content="Start rebase" Padding="20,6" Click="OnStart" IsEnabled="{Binding CanStart}" />
      </StackPanel>
    </StackPanel>

    <Border DockPanel.Dock="Bottom" Classes="panel" Padding="12" Margin="0,12,0,0" IsVisible="{Binding Selected.NeedsMessage, FallbackValue=False}">
      <StackPanel Spacing="6">
        <TextBlock Text="New commit message (first line = summary)" Classes="section" />
        <TextBox Text="{Binding Selected.Message}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" MaxHeight="160" />
      </StackPanel>
    </Border>

    <Border Classes="panel">
      <ListBox ItemsSource="{Binding Rows}" SelectedItem="{Binding Selected}" Classes="tight">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:RebaseRow">
            <Grid ColumnDefinitions="Auto,150,78,*" Height="34" Opacity="{Binding IsDropped, Converter={x:Static c:Converters.DroppedOpacity}}">
              <StackPanel Orientation="Horizontal" Spacing="2" Margin="0,0,10,0" VerticalAlignment="Center">
                <Button Classes="mini" Content="▲" Command="{Binding #RebaseRoot.((vm:RebaseViewModel)DataContext).MoveUpCommand}" CommandParameter="{Binding}" />
                <Button Classes="mini" Content="▼" Command="{Binding #RebaseRoot.((vm:RebaseViewModel)DataContext).MoveDownCommand}" CommandParameter="{Binding}" />
              </StackPanel>
              <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:RebaseViewModel.Actions}" SelectedItem="{Binding Action}" Width="136" VerticalAlignment="Center" />
              <TextBlock Grid.Column="2" Text="{Binding ShortSha}" Classes="mono muted" VerticalAlignment="Center" />
              <TextBlock Grid.Column="3" Text="{Binding Subject}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Margin="{Binding IsFolded, Converter={x:Static c:Converters.FoldedIndent}}"
                         TextDecorations="{Binding IsDropped, Converter={x:Static c:Converters.StrikeIf}}" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>
  </DockPanel>
</Window>
