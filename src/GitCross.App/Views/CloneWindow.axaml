<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="GitCross.App.Views.CloneWindow"
        Title="Clone repository" Width="560" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="24" Spacing="14">
    <TextBlock Text="Clone a repository" FontSize="20" FontWeight="Bold" />
    <StackPanel Spacing="4">
      <TextBlock Text="Repository URL" Classes="section" />
      <TextBox x:Name="UrlBox" Watermark="https://github.com/owner/repo.git" />
    </StackPanel>
    <StackPanel Spacing="4">
      <TextBlock Text="Destination folder" Classes="section" />
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Browse…" Margin="8,0,0,0" Click="OnBrowse" />
        <TextBox x:Name="ParentBox" />
      </DockPanel>
      <TextBlock x:Name="TargetText" Classes="muted" FontSize="12" />
    </StackPanel>
    <TextBlock x:Name="ErrorText" Foreground="#E5484D" TextWrapping="Wrap" IsVisible="False" />
    <ProgressBar x:Name="Progress" IsIndeterminate="True" IsVisible="False" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="OnCancel" />
      <Button x:Name="CloneButton" Classes="accent" Content="Clone" Padding="18,6" Click="OnClone" IsDefault="True" />
    </StackPanel>
  </StackPanel>
</Window>
